# Copy to .env for local use. Never commit .env.
# Where the SQLite database and uploaded files go. In Docker these default to /data/...
WHYMOVED_DB=data/whymoved.db
WHYMOVED_DATA_DIR=data/uploads
# Largest accepted upload, in megabytes.
WHYMOVED_MAX_UPLOAD_MB=20
# Only needed if the browser app is served from a different address than the API
# (comma-separated origins). Leave empty when FastAPI serves the app itself.
WHYMOVED_CORS=
# Port the container listens on (many hosts set this for you).
PORT=8000
